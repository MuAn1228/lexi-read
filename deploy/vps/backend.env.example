# Copy to backend.env on the server, then enter your key in a local editor.
# Never commit backend.env or send its contents to chat.
OCR_PROVIDER=paddle
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-3.0-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_JSON_MODE=false
LLM_MAX_TOKENS=4096

# Public-only attempt limits reset at midnight UTC; failed attempts also count.
PUBLIC_LLM_DAILY_LIMIT=200
PUBLIC_LLM_USER_DAILY_LIMIT=20
PUBLIC_OCR_DAILY_LIMIT=50
PUBLIC_OCR_USER_DAILY_LIMIT=5
PUBLIC_SIGNUP_DAILY_LIMIT=200
PUBLIC_SIGNUP_HOURLY_LIMIT=10
PUBLIC_MAX_DOCUMENTS_PER_USER=30
