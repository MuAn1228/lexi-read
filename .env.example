# Copy to .env in this directory. Never commit real API keys.
DATA_DIR=backend/data
# Local mode retains the original user 1. Public deployments require guest credentials.
APP_MODE=local

# Optional: Maimemo personal OpenAPI, available in local mode only.
# App: My > More settings > Experimental > Open API. Enable automatic sync.
# Keep this credential on this computer; never put it in VITE_* variables.
MAIMEMO_API_TOKEN=
OCR_PROVIDER=paddle
# 1–8 threads. Use 2 to reduce CPU contention during local reading.
OCR_CPU_THREADS=4
# Without API credentials, the app offers clearly labeled limited offline examples.
LLM_PROVIDER=offline
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Disable this parameter for providers that do not document response_format.
# JSON content is always validated, regardless of this setting.
LLM_JSON_MODE=true
LLM_MAX_TOKENS=4096
# Agnes 3.0 Flash preset (see README; set LLM_API_KEY locally):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://apihub.agnes-ai.com/v1
# LLM_MODEL=agnes-3.0-flash
# LLM_TIMEOUT_SECONDS=60
# LLM_JSON_MODE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public-only attempt limits, reset at midnight UTC; failed attempts count too.
PUBLIC_LLM_DAILY_LIMIT=200
PUBLIC_LLM_USER_DAILY_LIMIT=20
PUBLIC_OCR_DAILY_LIMIT=50
PUBLIC_OCR_USER_DAILY_LIMIT=5
PUBLIC_SIGNUP_DAILY_LIMIT=200
PUBLIC_SIGNUP_HOURLY_LIMIT=10
PUBLIC_MAX_DOCUMENTS_PER_USER=30
