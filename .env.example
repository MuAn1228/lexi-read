# Copy to .env in this directory. Never commit real API keys.
DATA_DIR=backend/data
OCR_PROVIDER=paddle
# Without API credentials, the app offers clearly labeled limited offline examples.
LLM_PROVIDER=offline
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
