# Copy to .env in this directory. Never commit real API keys.
DATA_DIR=backend/data
OCR_PROVIDER=paddle
# Without API credentials, the app offers clearly labeled limited offline examples.
LLM_PROVIDER=offline
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Disable this parameter for providers that do not document response_format.
# JSON content is always validated, regardless of this setting.
LLM_JSON_MODE=true
LLM_MAX_TOKENS=4096
# Agnes 3.0 Flash preset (see README; set LLM_API_KEY locally):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://apihub.agnes-ai.com/v1
# LLM_MODEL=agnes-3.0-flash
# LLM_TIMEOUT_SECONDS=60
# LLM_JSON_MODE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
