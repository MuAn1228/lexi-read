# Public build-time setting: VITE_ values are visible to every visitor.
# Leave empty for the local Vite proxy or a same-origin FastAPI deployment.
# For GitHub Pages, set the HTTPS origin of the separately hosted backend.
# Example: VITE_API_ORIGIN=https://api.example.com
# Use only the origin (no /api, other path, credentials, query or fragment).
# Never put API keys or other secrets in frontend environment variables.
VITE_API_ORIGIN=
